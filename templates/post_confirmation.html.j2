{% extends "base.html.j2" %}
{% block content %}
<div class="col-md-8 mx-auto py-4">
  <div class="card shadow-sm">
    <div class="card-body">
      <h1 class="h4 card-title">Create a post</h1>
      <form action="{{ url_for('add_post') }}" method="POST">
        <div class="mb-3">
          <label for="post-content" class="form-label">Your post</label>
          <textarea class="form-control" id="post-content" name="content" rows="5" required>{{ content }}</textarea>
        </div>
        <button type="submit" class="btn btn-primary">Review post</button>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="guidelineWarningModal" tabindex="-1" aria-labelledby="guidelineWarningTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="guidelineWarningTitle">Review before posting</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>This post might break the community guidelines. The automatic check can make mistakes, so please review your post before sharing.</p>
        <a href="{{ url_for('rules') }}">Read the community guidelines</a>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <form action="{{ url_for('add_post') }}" method="POST">
          <input type="hidden" name="content" value="{{ content }}">
          <input type="hidden" name="confirm_post" value="1">
          <button type="submit" class="btn btn-primary">Post Anyways</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const warningModal = document.getElementById('guidelineWarningModal');
  bootstrap.Modal.getOrCreateInstance(warningModal).show();
});
</script>
{% endblock %}